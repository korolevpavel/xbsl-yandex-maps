импорт Настройки

@ВПроекте
@НаСервере
метод ПолучитьApiKeyИзНастроек(): Строка?
    исп КонтекстДоступа.Дополнить(Тип<НастройкиYandexMaps.Запись>, [НаборКонстантПраво.Чтение])

    знч Настройки = НастройкиYandexMaps.Получить()
    возврат Настройки.ApiKey?.Раскрыть()
;

@ВПроекте
@НаСервере
метод ПолучитьApiKeyV3ИзНастроек(): Строка?
    исп КонтекстДоступа.Дополнить(Тип<НастройкиYandexMaps.Запись>, [НаборКонстантПраво.Чтение])

    знч Настройки = НастройкиYandexMaps.Получить()
    возврат Настройки.ApiKeyV3?.Раскрыть()
;

@ВПроекте
@НаСервере
метод ПолучитьДиагностическоеСообщение(ApiKeyПереопределение: Строка?, ApiKeyИзНастроек: Строка?, ApiKeyV3ИзНастроек: Строка?, ВерсияApi: Строка): Строка?
    если ApiKeyЗаполнен(ApiKeyПереопределение)
        возврат Неопределено
    ;

    если ВерсияApi == "3"
        если ApiKeyЗаполнен(ApiKeyV3ИзНастроек) или ApiKeyЗаполнен(ApiKeyИзНастроек)
            возврат Неопределено
        ;
        возврат "Не найден API key для Яндекс Карт (v3). Заполните НастройкиYandexMaps.ApiKeyV3 или передайте ApiKey в свойстве компонента."
    ;

    если ApiKeyЗаполнен(ApiKeyИзНастроек)
        возврат Неопределено
    ;

    возврат "Не найден API key для Яндекс Карт. Заполните НастройкиYandexMaps.ApiKey или передайте ApiKey в свойстве компонента."
;

@Локально
метод ApiKeyЗаполнен(ApiKey: Строка?): Булево
    возврат ApiKey != Неопределено и не ApiKey.Пусто()
;
