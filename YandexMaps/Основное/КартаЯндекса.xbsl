импорт Основное
импорт Служебные

@НаСервере @ДоступноСКлиента
@Контекстный
метод СформироватьHtmlДокумент(): Строка
    знч ApiKeyИзНастроек = СервисYandexMaps.ПолучитьApiKeyИзНастроек()
    знч ApiKeyV3ИзНастроек = СервисYandexMaps.ПолучитьApiKeyV3ИзНастроек()

    пер ЭффективныйApiKey = ApiKeyИзНастроек
    если ВерсияApi == "3" и ApiKeyV3ИзНастроек != Неопределено и не ApiKeyV3ИзНастроек.Пусто()
        ЭффективныйApiKey = ApiKeyV3ИзНастроек
    ;
    если ApiKey != Неопределено и не ApiKey.Пусто()
        ЭффективныйApiKey = ApiKey
    ;

    если ЭффективныйApiKey == Неопределено или ЭффективныйApiKey.Пусто()
        пер ДиагностическоеСообщение = СервисYandexMaps.ПолучитьДиагностическоеСообщение(ApiKey, ApiKeyИзНастроек, ApiKeyV3ИзНастроек, ВерсияApi)
        если ДиагностическоеСообщение == Неопределено
            ДиагностическоеСообщение = "Не удалось получить API key для Яндекс Карт."
        ;
        возврат СформироватьДокументОшибки(ДиагностическоеСообщение)
    ;

    знч МеткиДляКарты = Метки

    пер ApiKeyJson = СериализацияJson.ЗаписатьОбъект(ЭффективныйApiKey)
    пер МеткиJson = СериализацияJson.ЗаписатьОбъект(МеткиДляКарты)
    пер CenterLatJson = "null"
    пер CenterLngJson = "null"
    пер ZoomJson = "null"
    если ЦентрШирота != Неопределено
        CenterLatJson = СериализацияJson.ЗаписатьОбъект(ЦентрШирота)
    ;
    если ЦентрДолгота != Неопределено
        CenterLngJson = СериализацияJson.ЗаписатьОбъект(ЦентрДолгота)
    ;
    если Масштаб != Неопределено
        ZoomJson = СериализацияJson.ЗаписатьОбъект(Масштаб)
    ;

    пер КонфигурацияJson =
        "{"
        + "\"ApiKey\":" + ApiKeyJson
        + ",\"Markers\":" + МеткиJson
        + ",\"CenterLat\":" + CenterLatJson
        + ",\"CenterLng\":" + CenterLngJson
        + ",\"Zoom\":" + ZoomJson
        + ",\"AutoFitBounds\":" + СериализацияJson.ЗаписатьОбъект(АвтоПодобратьГраницы)
        + ",\"ClusterizeMarkers\":" + СериализацияJson.ЗаписатьОбъект(КластеризоватьМетки)
        + "}"
    КонфигурацияJson = КонфигурацияJson.Заменить("</", "<\\/")

    если ВерсияApi == "3"
        возврат СформироватьДокументV3(КонфигурацияJson)
    ;

    возврат СформироватьДокументV2(КонфигурацияJson)
;

@НаСервере
метод СформироватьДокументV2(КонфигурацияJson: Строка): Строка
    возврат
        "<!DOCTYPE html>\n"
        + "<html><head><meta charset='utf-8'>"
        + "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        + "<style>"
        + "html,body{margin:0;padding:0;height:100%;font-family:Arial,sans-serif;background:#f5f7fa;color:#1f2937;}"
        + "#root{position:relative;width:100%;height:100%;background:linear-gradient(180deg,#f8fafc 0%,#eef2ff 100%);}"
        + "#map{display:none;width:100%;height:100%;}"
        + "#status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;font-size:14px;line-height:1.5;color:#334155;}"
        + ".card{max-width:420px;padding:18px 20px;border-radius:16px;background:rgba(255,255,255,0.92);box-shadow:0 12px 30px rgba(15,23,42,0.12);}"
        + ".title{font-size:16px;font-weight:700;margin-bottom:8px;}"
        + "</style></head><body>"
        + "<div id='root'><div id='status'><div class='card'><div class='title'>Загрузка карты</div><div id='status-text'>Подключаем API Яндекс Карт...</div></div></div><div id='map'></div></div>"
        + "<script>"
        + "const config=" + КонфигурацияJson + ";"
        + "const statusElement=document.getElementById('status');"
        + "const statusText=document.getElementById('status-text');"
        + "const mapElement=document.getElementById('map');"
        + "function setStatus(message){statusText.textContent=message;statusElement.style.display='flex';mapElement.style.display='none';}"
        + "function showMap(){statusElement.style.display='none';mapElement.style.display='block';}"
        + "function buildBounds(markers){if(!markers||markers.length===0){return null;}let minLat=markers[0].lat;let minLng=markers[0].lng;let maxLat=markers[0].lat;let maxLng=markers[0].lng;markers.forEach(function(marker){minLat=Math.min(minLat,marker.lat);minLng=Math.min(minLng,marker.lng);maxLat=Math.max(maxLat,marker.lat);maxLng=Math.max(maxLng,marker.lng);});return [[minLat,minLng],[maxLat,maxLng]];}"
        + "function createPlacemark(marker){return new ymaps.Placemark([marker.lat,marker.lng],{balloonContentHeader:marker.title||'',balloonContentBody:marker.description||'',hintContent:marker.title||''});}"
        + "function initMap(){try{const markers=config.Markers||[];const hasExplicitViewport=config.CenterLat!==null&&config.CenterLat!==undefined&&config.CenterLng!==null&&config.CenterLng!==undefined&&config.Zoom!==null&&config.Zoom!==undefined;const hasSingleMarker=markers.length===1;const initialCenter=hasExplicitViewport?[config.CenterLat,config.CenterLng]:(hasSingleMarker?[markers[0].lat,markers[0].lng]:[55.751244,37.618423]);const initialZoom=hasExplicitViewport?config.Zoom:(hasSingleMarker?(config.Zoom||16):(config.Zoom||10));const map=new ymaps.Map('map',{center:initialCenter,zoom:initialZoom,controls:['zoomControl','fullscreenControl']},{suppressMapOpenBlock:true});const placemarks=markers.map(createPlacemark);if(config.ClusterizeMarkers&&placemarks.length>0){const clusterer=new ymaps.Clusterer({preset:'islands#invertedBlueClusterIcons'});clusterer.add(placemarks);map.geoObjects.add(clusterer);}else{placemarks.forEach(function(placemark){map.geoObjects.add(placemark);});}if(placemarks.length>0){if(hasExplicitViewport){map.setCenter([config.CenterLat,config.CenterLng],config.Zoom,{checkZoomRange:true});}else if(config.AutoFitBounds){const bounds=buildBounds(markers);if(bounds!==null){const isSinglePoint=bounds[0][0]===bounds[1][0]&&bounds[0][1]===bounds[1][1];if(isSinglePoint){map.setCenter(bounds[0],config.Zoom||16,{checkZoomRange:true});}else{map.setBounds(bounds,{checkZoomRange:true,zoomMargin:32});}}}else if(hasSingleMarker){map.setCenter([markers[0].lat,markers[0].lng],config.Zoom||16,{checkZoomRange:true});}}showMap();}catch(error){setStatus('Не удалось инициализировать карту.');console.error(error);}}"
        + "function loadApi(){const script=document.createElement('script');script.src='https://api-maps.yandex.ru/2.1/?lang=ru_RU&apikey='+encodeURIComponent(config.ApiKey);script.onload=function(){if(window.ymaps){ymaps.ready(initMap);}else{setStatus('API Яндекс Карт не вернул объект ymaps.');}};script.onerror=function(){setStatus('Не удалось загрузить API Яндекс Карт. Проверьте корректность ApiKey и доступность домена.');};document.head.appendChild(script);}"
        + "loadApi();"
        + "</script></body></html>"
;

@НаСервере
метод СформироватьДокументV3(КонфигурацияJson: Строка): Строка
    возврат
        "<!DOCTYPE html>\n"
        + "<html><head><meta charset='utf-8'>"
        + "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        + "<meta name='referrer' content='no-referrer-when-downgrade'>"
        + "<style>"
        + "html,body{margin:0;padding:0;height:100%;font-family:Arial,sans-serif;background:#f5f7fa;color:#1f2937;}"
        + "#root{position:relative;width:100%;height:100%;background:linear-gradient(180deg,#f8fafc 0%,#eef2ff 100%);}"
        + "#map{display:none;width:100%;height:100%;}"
        + "#status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;text-align:center;font-size:14px;line-height:1.5;color:#334155;}"
        + ".card{max-width:420px;padding:18px 20px;border-radius:16px;background:rgba(255,255,255,0.92);box-shadow:0 12px 30px rgba(15,23,42,0.12);}"
        + ".title{font-size:16px;font-weight:700;margin-bottom:8px;}"
        + ".marker{width:16px;height:16px;background:#1976D2;border:2px solid #fff;border-radius:50%;cursor:pointer;box-shadow:0 2px 4px rgba(0,0,0,.4);position:relative;}"
        + ".cluster{background:#1976D2;color:#fff;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;font-weight:700;cursor:pointer;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.4);}"
        + ".balloon{position:absolute;bottom:calc(100% + 10px);left:50%;transform:translateX(-50%);background:#fff;border-radius:8px;padding:12px 14px 10px;min-width:160px;max-width:240px;box-shadow:0 4px 16px rgba(0,0,0,.2);white-space:normal;z-index:999;pointer-events:auto;}"
        + ".balloon::after{content:'';position:absolute;top:100%;left:50%;transform:translateX(-50%);border:6px solid transparent;border-top-color:#fff;}"
        + ".balloon-title{font-weight:600;font-size:13px;margin-bottom:4px;padding-right:16px;color:#1f2937;}"
        + ".balloon-desc{font-size:12px;color:#475569;line-height:1.4;}"
        + ".balloon-close{position:absolute;top:8px;right:10px;cursor:pointer;font-size:16px;color:#94a3b8;line-height:1;}"
        + ".balloon-close:hover{color:#1f2937;}"
        + "</style></head><body>"
        + "<div id='root'><div id='status'><div class='card'><div class='title'>Загрузка карты</div><div id='status-text'>Подключаем API Яндекс Карт...</div></div></div><div id='map'></div></div>"
        + "<script>"
        + "const config=" + КонфигурацияJson + ";"
        + "const statusElement=document.getElementById('status');"
        + "const statusText=document.getElementById('status-text');"
        + "const mapElement=document.getElementById('map');"
        + "function setStatus(msg){statusText.textContent=msg;statusElement.style.display='flex';mapElement.style.display='none';}"
        + "function showMap(){statusElement.style.display='none';mapElement.style.display='block';}"
        + "(async function(){"
        + "try{"
        + "await new Promise(function(res,rej){var s=document.createElement('script');s.src='https://api-maps.yandex.ru/v3/?apikey='+encodeURIComponent(config.ApiKey)+'&lang=ru_RU';s.referrerPolicy='no-referrer-when-downgrade';s.onload=res;s.onerror=function(){rej(new Error('Не удалось загрузить API Яндекс Карт. Проверьте корректность ApiKey и доступность домена.'));};document.head.appendChild(s);});"
        + "await ymaps3.ready;"
        + "var markers=config.Markers||[];"
        + "var hasExplicit=config.CenterLat!=null&&config.CenterLng!=null&&config.Zoom!=null;"
        + "var hasSingle=markers.length===1;"
        + "var center=hasExplicit?[config.CenterLng,config.CenterLat]:(hasSingle?[markers[0].lng,markers[0].lat]:[37.618423,55.751244]);"
        + "var zoom=hasExplicit?config.Zoom:(hasSingle?(config.Zoom||16):(config.Zoom||10));"
        + "if(ymaps3.import&&ymaps3.import.registerCdn){ymaps3.import.registerCdn('https://cdn.jsdelivr.net/npm/{package}',['@yandex/ymaps3-clusterer@0.0','@yandex/ymaps3-default-ui-theme@0.0']);}"
        + "var markerSourceId='yandexmaps-markers';"
        + "var map=new ymaps3.YMap(mapElement,{location:{center:center,zoom:zoom}});"
        + "map.addChild(new ymaps3.YMapDefaultSchemeLayer({}));"
        + "map.addChild(new ymaps3.YMapDefaultFeaturesLayer({}));"
        + "if(ymaps3.YMapFeatureDataSource&&ymaps3.YMapLayer){map.addChild(new ymaps3.YMapFeatureDataSource({id:markerSourceId}));map.addChild(new ymaps3.YMapLayer({source:markerSourceId,type:'markers',zIndex:1800}));}"
        + "try{var ui=await ymaps3.import('@yandex/ymaps3-default-ui-theme');var ctrls=new ymaps3.YMapControls({position:'right'});ctrls.addChild(new ui.YMapZoomControl({}));map.addChild(ctrls);}catch(controlError){console.warn(controlError);}"
        + "var activeEl=null;"
        + "function esc(s){return s?String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'):'';}"
        + "function closePopup(){if(activeEl){var b=activeEl.querySelector('.balloon');if(b)b.remove();activeEl=null;}}"
        + "function openPopup(el,marker){closePopup();if(!marker.title&&!marker.description){return;}var p=document.createElement('div');p.className='balloon';p.innerHTML=(marker.title?'<div class=\"balloon-title\">'+esc(marker.title)+'<\\/div>':'')+(marker.description?'<div class=\"balloon-desc\">'+esc(marker.description)+'<\\/div>':'')+'<span class=\"balloon-close\">&#215;<\\/span>';p.querySelector('.balloon-close').addEventListener('click',function(e){e.stopPropagation();closePopup();});el.appendChild(p);activeEl=el;}"
        + "function makeEl(m){var el=document.createElement('div');el.className='marker';el.title=m.title||'';el.addEventListener('click',function(e){e.stopPropagation();openPopup(el,m);});return el;}"
        + "function markerProps(coords){return {coordinates:coords,source:markerSourceId};}"
        + "function addPlainMarkers(){markers.forEach(function(m){map.addChild(new ymaps3.YMapMarker(markerProps([m.lng,m.lat]),makeEl(m)));});}"
        + "if(config.ClusterizeMarkers&&markers.length>0){"
        + "var pkg=null;try{pkg=await ymaps3.import('@yandex/ymaps3-clusterer');}catch(clusterError){console.warn(clusterError);}"
        + "if(pkg){var clusterer=new pkg.YMapClusterer({method:pkg.clusterByGrid({gridSize:64}),features:markers.map(function(m,i){return {type:'Feature',id:m.id||String(i),geometry:{type:'Point',coordinates:[m.lng,m.lat]},properties:m};}),marker:function(f){return new ymaps3.YMapMarker(markerProps(f.geometry.coordinates),makeEl(f.properties));},cluster:function(coords,fs){var el=document.createElement('div');el.className='cluster';el.textContent=fs.length;return new ymaps3.YMapMarker(markerProps(coords),el);}});map.addChild(clusterer);}else{addPlainMarkers();}"
        + "}else{addPlainMarkers();}"
        + "if(markers.length>1&&!hasExplicit&&config.AutoFitBounds){var minLng=markers[0].lng,maxLng=markers[0].lng,minLat=markers[0].lat,maxLat=markers[0].lat;markers.forEach(function(m){minLng=Math.min(minLng,m.lng);maxLng=Math.max(maxLng,m.lng);minLat=Math.min(minLat,m.lat);maxLat=Math.max(maxLat,m.lat);});map.setLocation({bounds:[[minLng,minLat],[maxLng,maxLat]],duration:0});}"
        + "showMap();"
        + "}catch(e){setStatus(e.message||'Не удалось инициализировать карту.');console.error(e);}"
        + "})();"
        + "</script></body></html>"
;

@НаСервере
метод СформироватьДокументОшибки(Сообщение: Строка): Строка
    возврат
        "<!DOCTYPE html>\n"
        + "<html><head><meta charset='utf-8'>"
        + "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        + "<style>"
        + "html,body{margin:0;padding:0;height:100%;font-family:Arial,sans-serif;background:linear-gradient(180deg,#f8fafc 0%,#eef2ff 100%);color:#1f2937;}"
        + "body{display:flex;align-items:center;justify-content:center;padding:24px;box-sizing:border-box;}"
        + ".card{max-width:420px;padding:20px 22px;border-radius:16px;background:rgba(255,255,255,0.95);box-shadow:0 12px 30px rgba(15,23,42,0.12);text-align:center;}"
        + ".title{font-size:16px;font-weight:700;margin-bottom:8px;}"
        + ".text{font-size:14px;line-height:1.5;color:#475569;}"
        + "</style></head><body><div class='card'><div class='title'>Карта недоступна</div><div class='text'>"
        + Сообщение
        + "</div></div></body></html>"
;
